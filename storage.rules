rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function canAccessCampaign(campaignId) {
      return isAdmin() ||
        (isAuthenticated() &&
          firestore.get(
            /databases/(default)/documents/campaigns/$(campaignId)
          ).data.userId == request.auth.uid);
    }

    function isCampaignPublic(campaignId) {
      return firestore.get(
          /databases/(default)/documents/campaigns/$(campaignId)
        ).data.isPublic == true &&
        firestore.get(
          /databases/(default)/documents/campaigns/$(campaignId)
        ).data.status == 'active';
    }

    function isValidImageUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= maxBytes &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/.*');
    }

    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidImageUpload(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /campaigns/{campaignId}/locations/{fileName} {
      allow read: if canAccessCampaign(campaignId) ||
        isCampaignPublic(campaignId);
      allow create, update: if canAccessCampaign(campaignId) &&
        isValidImageUpload(20 * 1024 * 1024);
      allow delete: if canAccessCampaign(campaignId);
    }
  }
}
